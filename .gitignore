# ============================================================
# SECURITY: Never commit secrets or the local dev database
# ============================================================

# Local SQLite database (dev only — Vercel uses PostgreSQL)
*.db
*.sqlite
*.sqlite3
database/

# Environment variables (contains DATABASE_URL and SECRET_KEY)
.env
.env.*
*.env

# Python cache & bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor folders
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Vercel local dev cache
.vercel/
